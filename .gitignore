# ============================================================
# Python: bytecode y cachés generados automáticamente
# ============================================================
__pycache__/
*.py[cod]
*$py.class

# Cachés de herramientas de análisis, tipos y pruebas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# ============================================================
# Entornos virtuales: dependencias instaladas localmente
# ============================================================
venv/
venv_pc/
env/
.venv/

# ============================================================
# Django y ejecución local
# ============================================================
# Logs producidos por Django, comandos y servicios
*.log

# Configuración local alternativa
local_settings.py

# Base SQLite local y archivos auxiliares WAL/SHM/journal
*.sqlite3
*.sqlite3-*

# Las migraciones Django NO se ignoran: forman parte del código.

# ============================================================
# Variables de entorno y secretos
# ============================================================
# Ignora .env y todas sus variantes (.env.local, .env.production, etc.)
.env
.env.*

# Conserva únicamente la plantilla sin credenciales
!.env.example

# Llaves y contenedores de certificados privados
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# ============================================================
# Archivos estáticos, medios y cargas generadas
# ============================================================
# Resultado de python manage.py collectstatic
staticfiles/
static_collected/

# Contenido cargado por usuarios; permite conservar el marcador
media/*
!media/.gitkeep

# Temporales de carga y logs de procesos en segundo plano
temp_uploads/*
!temp_uploads/.gitkeep
uploads/

# Exportaciones y otros resultados generados
outputs/
exports/
reportes_generados/
archivos_temporales/

# ============================================================
# Datos operativos y planillas
# ============================================================
# Evita publicar exportaciones o fuentes con datos reales
*.xlsx
*.xls
*.xlsm
*.csv

# Permite plantillas o muestras sanitizadas con nombre explícito
!*.example.xlsx
!*.example.csv

# Nombres históricos conocidos del proyecto
datos_query_prueba.csv
VERSION ZONA PAGA.xlsx
estructura_proyecto.txt

# ============================================================
# Cobertura, empaquetado y archivos temporales
# ============================================================
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.eggs/
*.tmp
*.bak
*.swp
*~

# ============================================================
# Editores, notebooks y sistema operativo
# ============================================================
.vscode/
.idea/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Scripts e instructivos exclusivamente locales
# ============================================================
scripts_locales/
respaldo_scripts_locales/
*.local.py
probar_oracle.py
probar_conexion_oracle_server.py
medir_oracle.py
como activar.txt
# Manual operativo local: puede adaptarse con datos propios del servidor
/MANUAL_DESPLIEGUE_SERVIDOR_LOCAL.md
# Resultados locales de diagnósticos Oracle (pueden contener metadatos reales)
oracle/diagnostics/resultados_*.sql
oracle/diagnostics/output/
