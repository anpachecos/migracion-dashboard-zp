# =========================
# Oracle Completar
# =========================

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE_NAME=
ORACLE_CLIENT_PATH=


# =========================
# Django Completar
# =========================

# Obligatoria. Use una clave distinta por entorno y no versione el .env real.
SECRET_KEY=

# En producción se recomienda mantener DEBUG=False.
DEBUG=False

ALLOWED_HOSTS=

# Nombre del entorno: DESARROLLO, PRE o PRODUCCION. Se muestra como badge en el
# sidebar y en el login, para no tomar una pantalla de pruebas por la real.
# Cualquier otro valor impide el arranque.
AMBIENTE=DESARROLLO

DASHBOARD_SCHEDULER_ENABLED=False
DASHBOARD_SCHEDULER_EMBEDDED=False
DASHBOARD_LAUNCHER_MODE=development
DASHBOARD_WEB_HOST=127.0.0.1
DASHBOARD_WEB_PORT=8000
DASHBOARD_LOG_DIR=logs
ALERTAS_RECALCULO_DURABLE_ENABLED=False


# =========================
# Módulo de Transacciones (TRX C2D)
# =========================

# Solo lectura. Mantener False hasta validar el dataset contra los Excel de
# referencia del Informe Interno (27-08-2026 y 28-08-2026).
TRX_ORACLE_HABILITADO=False

# Universo ZP. Correlato de AMID_MINIMO_ALERTAS del panel de alertas.
TRX_AMID_MINIMO=7500000

# La fuente TRX tiene alto volumen: no cargar rangos amplios sin filtro.
TRX_RANGO_MAXIMO_DIAS=7
TRX_FILAS_POR_PAGINA=200
TRX_MAX_FILAS_DETALLE=2000

# Dia base del filtro de fechas: trx (dia de la TRX) o bd (dia de llegada).
TRX_MODO_FECHA_BASE=bd

# Grupos de Django con acceso al modulo de Transacciones, separados por coma.
# Debe coincidir EXACTAMENTE con auth_group: la comparacion es case-sensitive,
# "SONDA" no es "Sonda". Vaciar la lista deja el modulo solo para superusuarios.
TRX_GRUPOS_PERMITIDOS=Admin,SONDA


# =========================
# Motor de plantillas Excel
# =========================

# Grupos autorizados a SUBIR plantillas desde la pantalla de Transacciones.
# Ver y descargar sigue con TRX_GRUPOS_PERMITIDOS (incluye SONDA); subir crea
# versiones nuevas, que es lo unico del modulo que escribe en la base. Por eso
# la lista no incluye SONDA. Mismas reglas: case-sensitive, y vacia deja la
# captura solo para superusuarios.
EXCEL_TEMPLATES_GRUPOS_CAPTURA=Admin


# =========================
# Trabajos de archivos
# =========================

# Carpeta privada para XLSX generados por el worker. No debe estar dentro de
# staticfiles ni exponerse como URL pública.
PRIVATE_EXPORT_ROOT=data/exports
TRABAJOS_ARCHIVO_EXPIRACION_HORAS=72
TRABAJOS_WORKER_INTERVALO_SEGUNDOS=3
TRX_EXPORT_MAX_FILAS=100000
